# --- Project identity ---
# Identifies the target application this instance is running against — every
# per-project label (branch prefix, PR titles, Jira project) derives from this
# single value so the same codebase is reusable across target projects.
PROJECT_KEY="ELMS"

# --- System of record ---
# A dedicated database on your local Postgres server, separate from the target
# app's own database — never point this at the target app's DB.
DATABASE_URL="postgresql://postgres:root@localhost:5432/elms_a11y?schema=public"

# --- Target application (what the Scanner scans and the Developer agent fixes) ---
# Must point to an EXISTING Git repository root. If the path is missing or not a
# Git repo, the app will fail fast with a config error instead of proceeding.
TARGET_REPO_PATH="C:/My Workplace/EmployeeLeaveManagement"
TARGET_FRONTEND_URL="https://ashy-desert-0ae520400.7.azurestaticapps.net"
TARGET_SCAN_ROUTES="/,/login,/leave/new,/leave/history,/admin/approvals"
# How long to wait after triggering a merge before re-scanning, so CI/CD has
# time to deploy the change (default 60000ms if unset).
DEPLOY_SETTLE_MS="120000"

# --- Claude ---
ANTHROPIC_API_KEY=""
# Model/effort tiering (cost efficiency) — Haiku 4.5 by default for Developer/
# Reviewer/Conflict-resolver (the model that actually ran, and drove the
# known-good cost baseline, before the SDK upgrade). Override to Sonnet/Opus
# only if a target project's fixes need stronger reasoning.
# Effort is "low" by default — "high"/"medium" enable deep adaptive thinking,
# which is billed as output tokens and is not worth it for a scoped,
# mechanical accessibility fix. Raise it only if fix quality needs it.
CLAUDE_DEVELOPER_MODEL="claude-haiku-4-5-20251001"
CLAUDE_DEVELOPER_EFFORT="medium"
CLAUDE_REVIEWER_MODEL="claude-haiku-4-5-20251001"
CLAUDE_REVIEWER_EFFORT="medium"
CLAUDE_VISION_MODEL="claude-opus-4-6"
# Caps agentic turns per Developer/Autofix/Conflict-resolver SDK session —
# bounds runaway token spend without constraining a normal fix.
CLAUDE_DEVELOPER_MAX_TURNS="40"

# --- Labeling (branch names, commit messages, PR titles, Jira summaries) ---
# Optional — defaults to PROJECT_KEY if unset. Set this only if you want the
# GitHub-facing label to differ from PROJECT_KEY itself (rare).
# TICKET_LABEL_PREFIX=""

# --- Authentication for target app (optional — omit for public apps) ---
# TARGET_LOGIN_URL="/login"
# Multi-role credentials — comma-separated, format: label:email:password:route1;route2;route3
# TARGET_AUTH_ROLES="admin:admin@example.com:password:/dashboard;/employees,manager:mgr@example.com:password:/dashboard;/approvals"

# --- Scan sources — all on by default; set to "false" to disable one ---
# SCAN_PA11Y="true"
# SCAN_VISION="true"

# --- Observability ---
# Leave unset to trace to the console only.
# OTEL_EXPORTER_OTLP_ENDPOINT=""

# LangSmith — traces every agent (scan/triage/developer/reviewer/deploy/release,
# plus the two Claude Agent SDK model calls) end to end once these are set.
# Get an API key from smith.langchain.com. LANGCHAIN_* aliases are also
# accepted for backward compatibility, but LANGSMITH_* is the current name.
# LANGSMITH_TRACING_V2="true"
# LANGSMITH_API_KEY=""
# Optional — defaults to "<project-key>-a11y-agents" if unset.
# LANGSMITH_PROJECT=""

# --- Jira (Triage agent) ---
JIRA_BASE_URL=""
JIRA_EMAIL=""
JIRA_API_TOKEN=""
# Optional — defaults to PROJECT_KEY if unset.
# JIRA_PROJECT_KEY=""

# --- GitHub (Developer / Deploy / Release agents) ---
GITHUB_TOKEN=""
GITHUB_OWNER=""
GITHUB_REPO="employee-leave-management-system"
GITHUB_BASE_BRANCH="master"
GITHUB_QA_BRANCH="qa"
# Required for git commit on CI/server machines without a global Git identity.
GIT_AUTHOR_NAME="ForgeAI Bot"
GIT_AUTHOR_EMAIL="forgeai-bot@users.noreply.github.com"

# --- Notifications ---
SLACK_WEBHOOK_URL=""
# Email (Release agent's cycle report) — optional, via SMTP
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
EMAIL_FROM=""
EMAIL_TO=""
