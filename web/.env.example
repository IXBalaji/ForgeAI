# Same Postgres database the orchestrator writes to (Neon pooled connection
# string in production; local Postgres in dev).
DATABASE_URL="postgresql://postgres:root@localhost:5432/elms_a11y?schema=public"

# --- Dashboard display fields (mirrors the root .env values used by the CLI) ---
TARGET_FRONTEND_URL="https://ashy-desert-0ae520400.7.azurestaticapps.net"
GITHUB_OWNER="IXBalaji"
GITHUB_REPO="employee-leave-management-system"
GITHUB_QA_BRANCH="qa"
PROJECT_KEY="ELMS"

# --- Triggering the orchestrator ---
# Local dev only: when set, `npm run dev` inside web/ still spawns the
# orchestrator as a local child process (original behavior). Omit this in
# production — see GH_ACTIONS_PAT below instead.
ORCHESTRATOR_REPO_ROOT=""

# Production: a GitHub PAT with `actions:write` on this repo, used to trigger
# .github/workflows/orchestrate.yml via the workflow_dispatch API. Required
# for the Start button to work when deployed on Vercel (no local child
# process is possible there).
GH_ACTIONS_PAT=""
GH_WORKFLOW_OWNER="IXBalaji"
GH_WORKFLOW_REPO="ForgeAI"
GH_WORKFLOW_FILE="orchestrate.yml"
GH_WORKFLOW_REF="deployment-fixes"
