# Copy this to .env.local and fill in the DATABASE_URL from the root .env

# Required - same Postgres database the root package uses
DATABASE_URL="postgresql://postgres:root@localhost:5432/elms_a11y?schema=public"

# Optional - these are for display-only purposes in the confirmation dialog
# (shown to the user before starting a run). Copy from the root .env if desired.
NEXT_PUBLIC_TARGET_FRONTEND_URL="https://example.com"
NEXT_PUBLIC_GITHUB_OWNER="your-org"
NEXT_PUBLIC_GITHUB_REPO="your-repo"
NEXT_PUBLIC_GITHUB_QA_BRANCH="qa"
NEXT_PUBLIC_PROJECT_KEY="EXAMPLE"

# Optional - absolute path to the root ForgeAI directory, used by the spawn
# logic to find src/cli/index.ts. Defaults to one level up from web/ if unset.
# ORCHESTRATOR_REPO_ROOT="C:/Projects/prospect -01/ForgeAI"
