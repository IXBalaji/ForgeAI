{
  "name": "a11y-agent-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Autonomous accessibility remediation agent system — scan, triage, fix, review, deploy, loop, release.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli/index.ts",
    "scan": "playwright test && node src/scan/scripts/generate-a11y-report.mjs",
    "scan:agent": "tsx src/cli/index.ts scan",
    "scan:playwright": "playwright test && node src/scan/scripts/generate-a11y-report.mjs",
    "triage": "tsx src/cli/index.ts triage",
    "triage:reports": "tsx src/cli/index.ts triage:reports",
    "triage:reports:dry": "tsx src/cli/index.ts triage:reports --dry-run",
    "fix": "tsx src/cli/index.ts fix",
    "review": "tsx src/cli/index.ts review",
    "deploy": "tsx src/cli/index.ts deploy",
    "release": "tsx src/cli/index.ts release",
    "sync:jira": "tsx src/cli/index.ts sync:jira",
    "fix:all": "tsx src/cli/index.ts fix:all",
    "review:deploy": "tsx src/cli/index.ts review:deploy",
    "pipeline": "tsx src/cli/index.ts orchestrate",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run",
    "test:a11y": "playwright test && npm run report:a11y",
    "test:a11y:headed": "playwright test --headed --workers=1 && npm run report:a11y",
    "report:a11y": "node src/scan/scripts/generate-a11y-report.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.1.0",
    "@anthropic-ai/sdk": "^0.115.0",
    "@axe-core/playwright": "^4.10.1",
    "@langchain/langgraph": "^0.2.0",
    "@langchain/langgraph-checkpoint-postgres": "^0.0.4",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.55.0",
    "@opentelemetry/sdk-node": "^0.55.0",
    "@opentelemetry/sdk-trace-node": "^1.28.0",
    "chrome-launcher": "^1.1.2",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.36.4",
    "langsmith": "^0.8.9",
    "pa11y": "^8.0.0",
    "pg": "^8.13.1",
    "playwright": "^1.49.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.28.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
